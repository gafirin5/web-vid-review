// OmniMedia AI Review Hub — Database Schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id            String   @id @default(uuid())
  name          String   @unique
  apiKeyHash    String   @unique
  modelProvider String   @default("unknown")
  avatarUrl     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  media       Media[]
  reviews     Review[]
  collections Collection[]
}

model Media {
  id               String   @id @default(uuid())
  title            String
  description      String?
  mediaType        String // "IMAGE" | "VIDEO"
  status           String   @default("APPROVED") // PENDING_REVIEW | APPROVED | REJECTED | ARCHIVED
  contentId        String?  // kode identifikasi (CID) dari pipeline/DTK; unik per (CID, role, index)
  role             String   @default("video") // video|cover|frame|pin|thumb
  index            Int      @default(0) // urutan frame/pin; 0 untuk video/cover
  characterCandidates String? // JSON array saran karakter
  game             String?
  creatorName      String?
  creatorSecUid    String?
  sourceUrl        String?
  sourcePlatform   String? // douyin|tiktok
  playlistId       String?
  pinterestBoard   String?
  visionVerdict    String? // PASS_CLEAN|PASS_REPLACE_COVER|REJECT_DIRTY_VIDEO
  pipelineStage    String   @default("intake") // intake|gated|scheduled|published|archived
  externalRefs     String? // JSON { youtubeVideoId, zernioPostId, ... }
  publishedAt      DateTime?
  purgeAt          DateTime?
  phash            String?
  reviewKind       String?  // "CHARACTER" | "TRIAGE" | null
  characterName    String?  // hasil review karakter (v1: free text)
  reviewNote       String?  // catatan reviewer untuk agent
  reviewedAt       DateTime?
  rejectCategory   String?  // DIRTY_TEXT|SKIT|SPONSOR|NON_COSPLAY|LOWRES|DUPLICATE
  rejectReason     String?
  rejectedAt       DateTime?
  quarantinedPath  String?  // path relatif dari REJECTED_ROOT (file utama)
  previousStoragePath String? // path relatif dari UPLOADS_ROOT sebelum karantina
  nsfwFlag         Boolean  @default(false)
  originalFileName String
  storagePath      String
  thumbnailPath    String?
  previewPath      String?
  mimeType         String
  sizeBytes        BigInt
  durationSeconds  Float?
  width            Int?
  height           Int?
  fileHash         String
  prompt           String?
  negativePrompt   String?
  generationParams String?
  transcript       String?
  hasAudio         Boolean  @default(false)
  autoTagged       Boolean  @default(false)
  agentId          String?
  createdAt        DateTime @default(now())

  agent       Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  reviews     Review[]
  tags        MediaTag[]
  winVotes    ComparisonVote[] @relation("VoteWinner")
  loseVotes   ComparisonVote[] @relation("VoteLoser")
  collections CollectionItem[]
  shares      ShareLink[]
  audits      MediaAudit[]

  @@unique([contentId, role, index])
  @@index([contentId])
  @@index([role])
  @@index([game])
  @@index([characterName])
  @@index([pipelineStage])
  @@index([purgeAt])
  @@index([mediaType])
  @@index([createdAt])
  @@index([agentId])
}

model Review {
  id               String   @id @default(uuid())
  mediaId          String
  authorType       String // "HUMAN" | "AI"
  authorName       String
  rating           Int // 1 - 10
  comment          String?
  timestampSeconds Float?
  createdAt        DateTime @default(now())

  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id])
  agentId String?

  @@index([mediaId])
}

model Tag {
  id    String     @id @default(uuid())
  name  String     @unique
  media MediaTag[]
}

model MediaTag {
  mediaId String
  tagId   String

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

model ComparisonVote {
  id        String   @id @default(uuid())
  winnerId  String
  loserId   String
  voterName String   @default("Anonymous")
  comment   String?
  createdAt DateTime @default(now())

  winner Media @relation("VoteWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser  Media @relation("VoteLoser", fields: [loserId], references: [id], onDelete: Cascade)

  @@index([winnerId])
  @@index([loserId])
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isPublic    Boolean  @default(true)
  agentId     String?
  createdAt   DateTime @default(now())

  agent  Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  items  CollectionItem[]
  shares ShareLink[]
}

model CollectionItem {
  collectionId String
  mediaId      String
  position     Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([collectionId, mediaId])
  @@index([mediaId])
}

model ShareLink {
  id           String    @id @default(uuid())
  token        String    @unique
  mediaId      String?
  collectionId String?
  expiresAt    DateTime?
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  media      Media?      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String?
  payload   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Character {
  id        String   @id @default(uuid())
  name      String
  game      String?
  aliases   String? // JSON array
  createdAt DateTime @default(now())

  @@unique([name, game])
  @@index([name])
  @@index([game])
}

model Game {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RetentionPolicy {
  role          String   @id
  retentionDays Int
  updatedAt     DateTime @updatedAt
}

model MediaAudit {
  id         String   @id @default(uuid())
  mediaId    String
  action     String // created|status_changed|rejected|restored|resolved|archived|purged
  fromStatus String?
  toStatus   String?
  actorType  String // HUMAN|AGENT|SYSTEM
  actorName  String?
  agentId    String?
  reasonCode String?
  note       String?
  createdAt  DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([createdAt])
}
