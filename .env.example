# ===== Database =====
DATABASE_URL="file:./dev.db"

# ===== Admin =====
# GANTI sebelum deploy ke server publik!
ADMIN_PASSWORD="admin123"

# ===== URL publik untuk tautan media di response MCP/API =====
PUBLIC_BASE_URL="http://localhost:3000"

# ===== Smart intelligence =====
# Auto-tagging heuristik (warna, orientasi, brightness, keyword). Set false untuk menonaktifkan.
AUTO_TAG="true"

# ===== Akses API (frictionless) =====
# open     = tanpa API key tetap bisa (identitas dari header x-agent-name)
# optional = tanpa key = anonim tanpa atribusi agent
# required = wajib API key
AUTH_MODE="open"
ANON_STATUS="APPROVED"
ANON_UPLOAD_PER_HOUR=20
ANON_REVIEW_PER_HOUR=120
DEFAULT_AGENT_NAME="Anonymous Agent"
ALLOW_AGENT_SELF_REGISTER="true"
CORS_ORIGINS="*"

# ===== Webhook (opsional) =====
# Pisahkan beberapa URL dengan koma. Event: media.uploaded, review.submitted, backup.completed, dst.
WEBHOOK_URLS=""
# Jika diset, setiap request webhook menyertakan header x-wvr-signature: sha256=<hmac>
WEBHOOK_SECRET=""

# ===== Rate limiting (per menit) =====
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_REVIEW=60
RATE_LIMIT_SEARCH=120
RATE_LIMIT_ADMIN=300
RATE_LIMIT_LOGIN=10

# ===== Remote sync opsional (rclone → Google Drive) =====
# Kosongkan untuk menonaktifkan. Contoh: "gdrive:featherduster"
# Setup remote sekali: rclone config
RCLONE_REMOTE=""
# Folder yang disalin (backups, dumps, rejected)
RCLONE_SYNC_TARGETS="backups,dumps,rejected"